{
  "compilerOptions": {
    "module": "esnext",
    "lib": [
      "es2022"
    ],
    "target": "es2022",
    "moduleResolution": "Node",
    "outDir": "dist",
    "baseUrl": "src/",
    "sourceMap": true,
    "strict": true,
    "experimentalDecorators": true,
    "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "allowJs": false,
    "typeRoots": [
      "./node_modules/@types",
      "./src/@types",
      "./node_modules/@types/screeps-arena/dist"
    ]
  },
  "exclude": [
    "node_modules"
  ]
}
